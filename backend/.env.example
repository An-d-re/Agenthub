# AgentHub 环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# DeepSeek API（主力模型，必填）
deepseek_api_key=
deepseek_base_url=https://api.deepseek.com/v1

# Anthropic API（可选，未配置自动降级 DeepSeek）
anthropic_api_key=

# OpenCode API（可选，未配置自动降级 DeepSeek）
opencode_api_key=
opencode_base_url=https://api.opencode.ai/v1

# 可选配置
# database_url=sqlite+aiosqlite:///./data/agenthub.db
# workspace_root=./workspaces
# cors_origins=["http://localhost:3000"]
